<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:c="using:Filee.App.Controls"
             xmlns:v="using:Filee.App.Views"
             x:Class="Filee.App.Views.Pages.AboutPage"
             x:DataType="vm:AboutPageViewModel">
  <UserControl.Styles>
    <!-- Wide: two equal columns with an 18 px gap (9 px either side of the middle). -->
    <Style Selector="Grid#InfoUpdateGrid > Border.info-card">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Margin" Value="0,0,9,0" />
    </Style>
    <Style Selector="Grid#InfoUpdateGrid > Border.update-card">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="9,0,0,0" />
    </Style>
    <!-- Narrow: stacked as before. -->
    <Style Selector="Grid#InfoUpdateGrid.stacked > Border.info-card">
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="Grid#InfoUpdateGrid.stacked > Border.update-card">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="Margin" Value="0,18,0,0" />
    </Style>
    <!-- The four ways to help: small tiles, an icon on the left and a title with one line beside it. -->
    <Style Selector="Button.help-tile">
      <Setter Property="CornerRadius" Value="{DynamicResource SoftRadius}" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="3" />
      <Setter Property="MinWidth" Value="176" />
      <!-- Long translations of a hint end in "…" instead of widening the tiles and squeezing the text beside them. -->
      <Setter Property="MaxWidth" Value="220" />
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.help-tile:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.help-tile Border.help-icon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Button.help-tile:pointerover Border.help-icon">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    </Style>
    <Style Selector="Button.help-tile TextBlock.help-title">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.help-tile TextBlock.help-hint">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="18">
    <TextBlock Classes="h1" Text="{DynamicResource about.title}" />
    <!-- Filee information and Updates sit side by side with equal widths. Below StackBelowWidth (see the code-behind)
         the grid gets the "stacked" class and the cards go back to one above the other. -->
    <Grid x:Name="InfoUpdateGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
      <Border Classes="card info-card">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
          <!-- Centered next to the text. Side by side, this card is stretched to the height of the Updates card, so a
               top-aligned logo would sit above the middle of the text. -->
          <Image Source="avares://Halodrop/Assets/Icons/morph.png" Width="72" Height="72" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Halodrop" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
              <!-- The version as a small pill, tinted with the accent (it follows the accent the user picked). The text colour
                   is set in the code-behind: the accent itself on dark, the deeper accent on light. -->
              <Border Classes="badge" Padding="10,3" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding Version}">
                <TextBlock x:Name="VersionText" Text="{Binding VersionBadge}" FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" />
              </Border>
            </StackPanel>
            <!-- Morph change: what Morph is and who makes it -->
            <TextBlock Classes="muted" Text="{DynamicResource app.tagline}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,6,0,0">
              <TextBlock Text="{DynamicResource about.made_by}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding DeveloperName}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button Classes="ghost" Padding="0" Click="OnOpenDeveloper">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.GitHub}" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding DeveloperLinkText}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Button>
            <TextBlock Classes="muted" Text="{DynamicResource about.license}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <Button Classes="ghost" Padding="0" Click="OnOpenRepository" Margin="0,4,0,0" IsVisible="{Binding HasRepository}">
              <!-- Morph change: a DockPanel, so a long link wraps inside the card; the address stays left to right -->
              <DockPanel>
                <PathIcon DockPanel.Dock="Left" Width="13" Height="13" Margin="0,0,6,0" Data="{StaticResource Icon.Link}" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding RepositoryDisplay}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" FlowDirection="LeftToRight" />
              </DockPanel>
            </Button>
            <!-- This version's "What's new" slides again -->
            <Button x:Name="WhatsNewLink" Classes="ghost" Padding="0" Command="{Binding ShowWhatsNewCommand}" IsVisible="{Binding HasWhatsNew}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Info}" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{Binding WhatsNewText}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Border Classes="card update-card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{DynamicResource about.updates}" />
          <!-- Morph change: no release repository yet, so no update checks: say so instead of offering them -->
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource about.updates_later}"
                     IsVisible="{Binding !HasRepository}" />
          <ToggleSwitch Content="{DynamicResource general.check_updates}" IsChecked="{Binding CheckForUpdates}"
                        IsVisible="{Binding HasRepository}" />
          <!-- Morph change: updates install by themselves while Morph is idle. -->
          <ToggleSwitch Content="{DynamicResource general.install_when_idle}" IsChecked="{Binding InstallWhenIdle}"
                        IsEnabled="{Binding CheckForUpdates}" IsVisible="{Binding HasRepository}" />
          <WrapPanel IsVisible="{Binding HasRepository}">
            <Button Command="{Binding CheckNowCommand}" Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- Turns while the check runs (Spin.IsActive follows CheckNowCommand.IsRunning; the code is in Controls/Spin.cs). -->
                <PathIcon c:Spin.IsActive="{Binding CheckNowCommand.IsRunning}"
                          Width="13" Height="13" Data="{StaticResource Icon.Refresh}" />
                <TextBlock Text="{DynamicResource general.check_now}" />
              </StackPanel>
            </Button>
            <Button Classes="accent" Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding UpdateAvailable}" Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Download}" />
                <TextBlock Text="{Binding UpdateButtonText}" />
              </StackPanel>
            </Button>
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding UpdateStatus}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
    <!-- The sponsors right below Morph itself and the updates, while there are any. Morph change: Morph's own list
         (Assets/Sponsors/sponsors.json), empty for now, so nothing shows. -->
    <Border Classes="card" IsVisible="{Binding #Supporters.IsVisible}">
      <StackPanel Spacing="12">
        <TextBlock Classes="h2" Text="{DynamicResource sponsor.thanks}" />
        <v:SupportersView x:Name="Supporters" ShowTitle="False" LogoHeight="40" />
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding HasRepository}"><!-- Morph change: star, issue and sponsor need Morph's own repository -->
      <!-- The text on the left, the four ways to help as small tiles on the right. -->
      <Grid ColumnDefinitions="*,20,Auto">
        <StackPanel Spacing="10" VerticalAlignment="Center">
          <TextBlock Classes="h2" Text="{DynamicResource about.support_title}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{DynamicResource about.support_text}" />
        </StackPanel>
        <UniformGrid Grid.Column="2" Columns="2" VerticalAlignment="Center">
          <Button Classes="help-tile" Click="OnStar">
            <Grid ColumnDefinitions="Auto,10,*">
              <Border Classes="help-icon"><PathIcon Width="16" Height="16" Data="{StaticResource Icon.Star}" Foreground="#E8B923" /></Border>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                <TextBlock Classes="help-title" Text="{DynamicResource about.tile_star}" />
                <TextBlock Classes="help-hint" Text="{DynamicResource about.tile_star_hint}" />
              </StackPanel>
            </Grid>
          </Button>
          <Button Classes="help-tile" Click="OnReport">
            <Grid ColumnDefinitions="Auto,10,*">
              <Border Classes="help-icon"><PathIcon Width="16" Height="16" Data="{StaticResource Icon.Bug}" Foreground="#3FB68B" /></Border>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                <TextBlock Classes="help-title" Text="{DynamicResource about.tile_report}" />
                <TextBlock Classes="help-hint" Text="{DynamicResource about.tile_report_hint}" />
              </StackPanel>
            </Grid>
          </Button>
          <Button Classes="help-tile" Click="OnSuggest">
            <Grid ColumnDefinitions="Auto,10,*">
              <Border Classes="help-icon"><PathIcon Width="16" Height="16" Data="{StaticResource Icon.Lightbulb}" Foreground="{DynamicResource AccentBrush}" /></Border>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                <TextBlock Classes="help-title" Text="{DynamicResource about.tile_suggest}" />
                <TextBlock Classes="help-hint" Text="{DynamicResource about.tile_suggest_hint}" />
              </StackPanel>
            </Grid>
          </Button>
          <Button Classes="help-tile" Click="OnSponsor" IsVisible="False"><!-- Halodrop change: no sponsor page yet -->
            <Grid ColumnDefinitions="Auto,10,*">
              <Border Classes="help-icon"><PathIcon Width="16" Height="16" Data="{StaticResource Icon.Heart}" Foreground="#D4537E" /></Border>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                <TextBlock Classes="help-title" Text="{DynamicResource about.sponsor}" />
                <TextBlock Classes="help-hint" Text="{DynamicResource about.tile_sponsor_hint}" />
              </StackPanel>
            </Grid>
          </Button>
        </UniformGrid>
      </Grid>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="h2" Text="{DynamicResource about.notices}" />
        <!-- The notices are in English: left to right in every language. -->
        <c:MarkdownView Markdown="{Binding Notices}" SkipTitle="True" FlowDirection="LeftToRight" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
