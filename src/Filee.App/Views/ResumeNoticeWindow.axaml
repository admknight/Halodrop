<!-- Morph change: "Some conversions didn't finish last time" card in the bottom-right corner (UnfinishedWork). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Filee.App.Views.ResumeNoticeWindow"
        Title="Morph"
        Width="400"
        SizeToContent="Height"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">
  <Border Classes="card" Margin="12" Padding="16,14">
    <DockPanel>
      <Image DockPanel.Dock="Left" Source="avares://Morph/Assets/Icons/morph.png" Width="36" Height="36"
             VerticalAlignment="Top" Margin="0,2,12,0" />
      <StackPanel Spacing="8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="icon" Padding="4" VerticalAlignment="Top" Click="OnNo"
                  AutomationProperties.Name="{DynamicResource common.close}">
            <PathIcon Width="12" Height="12" Data="{StaticResource Icon.Close}" />
          </Button>
          <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"
                     Text="{DynamicResource resume.title}" />
        </DockPanel>
        <TextBlock x:Name="Summary" Classes="caption" TextWrapping="Wrap" />
        <TextBlock x:Name="LeftOutText" Classes="caption danger" TextWrapping="Wrap" IsVisible="False" />
        <WrapPanel Margin="0,2,0,0">
          <Button x:Name="AgainButton" Classes="accent" Click="OnAgain" Padding="12,5" Margin="0,0,8,6"
                  Content="{DynamicResource resume.again}" />
          <Button Click="OnNo" Padding="12,5" Margin="0,0,8,6" Content="{DynamicResource resume.no}" />
        </WrapPanel>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
