<!--
  Shared MSBuild settings for every project in the repository.
  Keep project files small: anything common belongs here.
-->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs are reported by review, not by the compiler; documenting only the non-obvious
         parameters of a member is fine (CS1573). -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <Version>0.7.0</Version>
    <Product>Halodrop</Product>
    <Authors>Filee contributors</Authors>
    <Copyright>Copyright (c) Filee contributors</Copyright>

    <!-- Single source of truth for the GitHub repository (used by the updater and the About page). -->
    <!-- Morph: the repository Morph's releases come from (the updater and the About page). Empty would turn the
         updater off (it never asks Filee's repository). Filee itself, which Morph is based on, is UpstreamUrl. -->
    <FileeRepositoryUrl>https://github.com/admknight/Halodrop</FileeRepositoryUrl>
    <RepositoryUrl>$(FileeRepositoryUrl)</RepositoryUrl>
    <UpstreamUrl>https://github.com/KnifeLemon/Filee</UpstreamUrl>

    <!-- What an official build (-p:MorphRelease=true) checks before it installs an update (UpdateService).
         MorphUpdatePublicKey: the public half of Filee's update key (base64; build/new-update-key.ps1 makes the pair,
         build/sign-checksums.ps1 signs every release's SHA256SUMS files with the private half). With a key, an
         update without a valid signature is refused on every platform; empty, the same-release checksum is all.
         MorphExpectedPublisher and MorphExpectedIssuer: the Authenticode certificate every Windows installer must be
         signed with, its subject and the certificate authority that issued it. Before a renewed certificate comes
         from another authority, ship a release that lists both issuers ("|" between them).
         MorphExpectedSignerKeys: optionally the SHA-256s of the certificate public keys allowed, "|" between them.
         Halodrop change: Halodrop's own update key (made 22 Nov 2026; the release workflow signs with the private half,
         the repository secret MORPH_UPDATE_KEY). The publisher and issuer stay empty until Halodrop has a code-signing
         certificate; Filee's values were Filee's own. -->
    <MorphUpdatePublicKey>MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEsCtJPvAyBgMJCuGXlocABw0FQH6gR8B+pcGCTUVgHwa0zhPKL5cT1ttHyg1PdILIwEbJEZrpevYzweeO9dqLYA==</MorphUpdatePublicKey>
    <MorphExpectedPublisher></MorphExpectedPublisher>
    <MorphExpectedIssuer></MorphExpectedIssuer>
    <MorphExpectedSignerKeys></MorphExpectedSignerKeys>
  </PropertyGroup>

  <!-- Libraries their makers sign: ReadyToRun recompiles an assembly and drops its Authenticode signature, so these
       stay as shipped and keep it (Windows Smart App Control trusts signed code). build/sign-windows.ps1 signs the
       rest. Run it on a publish folder to see which files are still unsigned when a package is added. -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="CommunityToolkit.Mvvm.dll;HarfBuzzSharp.dll;SkiaSharp.dll" />
    <PublishReadyToRunExclude Include="Magick.NET-Q8-AnyCPU.dll;Magick.NET.Core.dll;PDFtoImage.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Extensions.DependencyInjection.Abstractions.dll;Microsoft.Extensions.DependencyInjection.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Extensions.Logging.Abstractions.dll;Microsoft.Extensions.Logging.dll" />
    <PublishReadyToRunExclude Include="Microsoft.Extensions.Options.dll;Microsoft.Extensions.Primitives.dll" />
    <PublishReadyToRunExclude Include="Microsoft.IO.RecyclableMemoryStream.dll;Microsoft.Maui.Graphics.dll;System.Security.Cryptography.Pkcs.dll" />
  </ItemGroup>
</Project>
